# Copy this file to ".env" and fill in your values.

# MongoDB Atlas connection string (Atlas → Connect → Drivers). Leave empty to use the local file database.
MONGODB_URI=
# Database name inside MongoDB
MONGODB_DB=selco_champions

# Optional
# PORT=8080
# PUBLIC_URL=https://your-domain.com
# ADMIN_ID=admin
# ADMIN_DEFAULT_PASSWORD=Selco@2026
