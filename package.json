{
  "name": "selco-champion-end-users",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SELCO Foundation \u2014 Champion End Users of Karnataka (3D map, profiles, admin & analytics)",
  "scripts": {
    "dev": "node server/index.js --dev",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "prod": "npm run build && node server/index.js",
    "build:demo": "vite build --config client/vite.config.js --mode demo",
    "images:compress": "node server/scripts/compress-existing.js",
    "share": "node server/scripts/share.js",
    "db:migrate": "node server/scripts/migrate-to-mongo.js",
    "admin:reset-password": "node server/scripts/reset-password.js"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.61.0",
    "mongodb": "^6.21.0",
    "motion": "^11.18.2",
    "multer": "^2.0.2",
    "qrcode": "1.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.4",
    "sharp": "^0.35.5",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "engines": {
    "node": ">=20.9"
  }
}
